<Window x:Class="TorqueMonitor.Views.GaugeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TorqueMonitor.Controls"
        Title="Torque Monitor Gauge"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="240" Height="240"
        Topmost="True">

    <Window.Resources>
        <!-- Dark Automotive Context Menu Styles -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#181B22"/>
            <Setter Property="BorderBrush" Value="#333842"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkmark / Icon -->
                                <Path x:Name="CheckMark" Data="M 2,7 L 6,11 L 14,3" Stroke="#00E5FF" StrokeThickness="2"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="14" Height="14"/>

                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                <Popup x:Name="SubMenuPopup" Placement="Right" IsOpen="{TemplateBinding IsSubmenuOpen}" Focusable="False" AllowsTransparency="True">
                                    <Border Background="#181B22" BorderBrush="#333842" BorderThickness="1" CornerRadius="6" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2F3B"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#2A2F3A"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>

    <!-- Transparent Root Container -->
    <Grid Background="Transparent">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="WindowScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
        </Grid.LayoutTransform>

        <!-- Hit Test Only on the Circular Instrument -->
        <Border x:Name="GaugeHostBorder"
                Background="Transparent"
                CornerRadius="120"
                Cursor="SizeAll"
                MouseLeftButtonDown="OnGaugeMouseLeftButtonDown"
                MouseRightButtonUp="OnGaugeMouseRightButtonUp"
                MouseWheel="OnGaugeMouseWheel">

            <!-- Analogue Gauge Component -->
            <controls:AnalogueGaugeControl x:Name="GaugeDisplay"/>
        </Border>
    </Grid>
</Window>
