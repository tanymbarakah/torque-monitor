<Window x:Class="TorqueMonitor.Views.DeveloperInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Developer Information — TORQUE MONITOR"
        Width="490" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown"
        Deactivated="OnWindowDeactivated">

    <Window.Resources>
        <!-- Subtle Glassmorphic Dark Container Style -->
        <LinearGradientBrush x:Key="DialogBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1E27" Offset="0.0"/>
            <GradientStop Color="#10131A" Offset="0.6"/>
            <GradientStop Color="#090B0F" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Clean Interactive Button Style -->
        <Style x:Key="SocialLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#181D26"/>
            <Setter Property="BorderBrush" Value="#2A3241"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#222A38"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#151C26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <Path Data="M 9,9 L 21,21 M 21,9 L 9,21"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.8"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D1518"/>
                                <Setter Property="Foreground" Value="#FF4D61"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#401B20"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fade & Scale Opening Animation -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="DialogRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0.0" To="1.0"
                                     Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.95" To="1.0"
                                     Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="ScaleXform"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.95" To="1.0"
                                     Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <!-- Dialog Outer Shell with Glass Shadow -->
    <Grid Margin="12">
        <Border x:Name="DialogRoot"
                Background="{StaticResource DialogBackground}"
                BorderBrush="#2A3241"
                BorderThickness="1"
                CornerRadius="10"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ScaleXform" ScaleX="1.0" ScaleY="1.0"/>
            </Border.RenderTransform>

            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.85"/>
            </Border.Effect>

            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Separator -->
                    <RowDefinition Height="Auto"/>
                    <!-- Developer Details -->
                    <RowDefinition Height="Auto"/>
                    <!-- Company & Contact -->
                    <RowDefinition Height="Auto"/>
                    <!-- Professional Links -->
                    <RowDefinition Height="Auto"/>
                    <!-- Application Telemetry & Licensing -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Header (Icon + Title + Close Button) -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimalist ⓘ Badge -->
                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#162E3B" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,10,0">
                        <TextBlock Text="ⓘ" Foreground="#00E5FF" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                    </Border>

                    <TextBlock Grid.Column="1"
                               Text="DEVELOPER &amp; PRODUCT INFORMATION"
                               FontFamily="Bahnschrift, Segoe UI, sans-serif"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="#E2E8F0"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="OnCloseButtonClick"
                            ToolTip="Close (Esc)"/>
                </Grid>

                <!-- Thin Line -->
                <Rectangle Grid.Row="1" Height="1" Fill="#232A37" Margin="0,14,0,16"/>

                <!-- 2. Developer Information Section -->
                <StackPanel Grid.Row="2" Margin="0,0,0,16">
                    <TextBlock x:Name="TxtDeveloperName"
                               Text="Tanym Barakah"
                               FontFamily="Bahnschrift, Segoe UI, sans-serif"
                               FontWeight="Bold"
                               FontSize="20"
                               Foreground="#FFFFFF"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtProfessionalTitle"
                                   Text="Software &amp; App Developer"
                                   FontFamily="Segoe UI, sans-serif"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#00E5FF"/>
                        <TextBlock Text=" • " Foreground="#64748B" FontSize="12"/>
                        <TextBlock x:Name="TxtDesignation"
                                   Text="Founder &amp; CEO @ NIHAR TECHNOLOGIES"
                                   FontFamily="Segoe UI, sans-serif"
                                   FontSize="12"
                                   Foreground="#94A3B8"/>
                    </StackPanel>

                    <!-- Country -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" x:Name="PanelCountry">
                        <!-- Location Icon -->
                        <Path Data="M 6,2 C 3.8,2 2,3.8 2,6 C 2,9 6,14 6,14 C 6,14 10,9 10,6 C 10,3.8 8.2,2 6,2 Z M 6,7.5 C 5.2,7.5 4.5,6.8 4.5,6 C 4.5,5.2 5.2,4.5 6,4.5 C 6.8,4.5 7.5,5.2 7.5,6 C 7.5,6.8 6.8,7.5 6,7.5 Z"
                              Fill="#64748B" Width="10" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtCountry"
                                   Text="Bangladesh"
                                   FontFamily="Segoe UI, sans-serif"
                                   FontSize="11.5"
                                   Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Company & Contact Card -->
                <Border Grid.Row="3" Background="#13171F" BorderBrush="#202734" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Company -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" x:Name="PanelCompany">
                            <TextBlock Text="ORGANIZATION:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#64748B" Width="95"/>
                            <TextBlock x:Name="TxtCompany" Text="NIHAR TECHNOLOGIES" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11.5" Foreground="#E2E8F0"/>
                        </StackPanel>

                        <!-- Website -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" x:Name="PanelWebsite">
                            <TextBlock Text="WEBSITE:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#64748B" Width="95"/>
                            <TextBlock Cursor="Hand" MouseLeftButtonUp="OnWebsiteClick">
                                <Underline>
                                    <Run x:Name="TxtWebsite" Text="https://nihartechnologies.com" FontFamily="Segoe UI" FontSize="11.5" Foreground="#00E5FF"/>
                                </Underline>
                            </TextBlock>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Orientation="Horizontal" x:Name="PanelEmail">
                            <TextBlock Text="EMAIL:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#64748B" Width="95"/>
                            <TextBlock Cursor="Hand" MouseLeftButtonUp="OnEmailClick">
                                <Underline>
                                    <Run x:Name="TxtEmail" Text="tanymbarakah@nihartechnologies.com" FontFamily="Segoe UI" FontSize="11.5" Foreground="#38BDF8"/>
                                </Underline>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Professional Social Links -->
                <StackPanel Grid.Row="4" Margin="0,0,0,16">
                    <TextBlock Text="CONNECT &amp; REPOSITORIES"
                               FontFamily="Segoe UI"
                               FontWeight="Bold"
                               FontSize="10"
                               Foreground="#64748B"
                               Margin="0,0,0,8"/>

                    <UniformGrid Columns="3" Rows="1">
                        <!-- GitHub -->
                        <Button Style="{StaticResource SocialLinkButtonStyle}" Click="OnGitHubClick" Margin="0,0,4,0" ToolTip="Tanym Barakah GitHub Profile">
                            <StackPanel Orientation="Horizontal">
                                <!-- GitHub Octocat Icon -->
                                <Path Data="M 8,0 C 3.58,0 0,3.58 0,8 C 0,11.54 2.29,14.53 5.47,15.59 C 5.87,15.66 6.02,15.42 6.02,15.21 C 6.02,15.02 6.01,14.39 6.01,13.72 C 3.79,14.2 3.32,12.79 3.32,12.79 C 2.95,11.87 2.42,11.62 2.42,11.62 C 1.7,11.12 2.48,11.13 2.48,11.13 C 3.28,11.19 3.7,11.96 3.7,11.96 C 4.41,13.19 5.57,12.83 6.03,12.63 C 6.1,12.11 6.31,11.76 6.54,11.56 C 4.77,11.36 2.91,10.67 2.91,7.58 C 2.91,6.7 3.22,5.99 3.74,5.43 C 3.66,5.23 3.38,4.41 3.82,3.31 C 3.82,3.31 4.49,3.1 6.02,4.13 C 6.66,3.95 7.34,3.86 8.01,3.86 C 8.68,3.86 9.36,3.95 10,4.13 C 11.53,3.1 12.2,3.31 12.2,3.31 C 12.64,4.41 12.36,5.23 12.28,5.43 C 12.8,5.99 13.11,6.7 13.11,7.58 C 13.11,10.68 11.24,11.36 9.46,11.56 C 9.75,11.81 10.02,12.31 10.02,13.07 C 10.02,14.16 10.01,15.04 10.01,15.21 C 10.01,15.42 10.15,15.67 10.56,15.59 C 13.73,14.52 16.02,11.54 16.02,8 C 16.02,3.58 12.44,0 8,0 Z"
                                      Fill="#00E5FF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="GitHub" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- LinkedIn -->
                        <Button Style="{StaticResource SocialLinkButtonStyle}" Click="OnLinkedInClick" Margin="2,0,2,0" ToolTip="Tanym Barakah LinkedIn Profile">
                            <StackPanel Orientation="Horizontal">
                                <!-- LinkedIn Icon -->
                                <Path Data="M 0,1.5 C 0,0.67 0.67,0 1.5,0 C 2.33,0 3,0.67 3,1.5 C 3,2.33 2.33,3 1.5,3 C 0.67,3 0,2.33 0,1.5 Z M 0.2,4.5 L 2.8,4.5 L 2.8,13 L 0.2,13 Z M 4.3,4.5 L 6.8,4.5 L 6.8,5.7 C 7.2,4.9 8.2,4.3 9.7,4.3 C 12.2,4.3 13,5.9 13,8.4 L 13,13 L 10.4,13 L 10.4,8.9 C 10.4,7.6 10.1,6.6 8.7,6.6 C 7.3,6.6 6.9,7.6 6.9,8.9 L 6.9,13 L 4.3,13 Z"
                                      Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="LinkedIn" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Facebook -->
                        <Button Style="{StaticResource SocialLinkButtonStyle}" Click="OnFacebookClick" Margin="4,0,0,0" ToolTip="Tanym Barakah Facebook Profile">
                            <StackPanel Orientation="Horizontal">
                                <!-- Facebook Icon -->
                                <Path Data="M 13.5,0 L 2.5,0 C 1.1,0 0,1.1 0,2.5 L 0,13.5 C 0,14.9 1.1,16 2.5,16 L 8.4,16 L 8.4,9.8 L 6.3,9.8 L 6.3,7.4 L 8.4,7.4 L 8.4,5.6 C 8.4,3.5 9.7,2.3 11.6,2.3 C 12.5,2.3 13.3,2.4 13.5,2.4 L 13.5,4.6 L 12.2,4.6 C 11.2,4.6 11,5.1 11,5.8 L 11,7.4 L 13.4,7.4 L 13.1,9.8 L 11,9.8 L 11,16 L 13.5,16 C 14.9,16 16,14.9 16,13.5 L 16,2.5 C 16,1.1 14.9,0 13.5,0 Z"
                                      Fill="#60A5FA" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="Facebook" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <!-- 5. Application Telemetry & Licensing Information -->
                <Border Grid.Row="5" Background="#11141A" BorderBrush="#1C222C" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- App & Version -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="SOFTWARE:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#64748B" Width="95"/>
                            <TextBlock Text="TORQUE MONITOR" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                            <TextBlock Text="  v1.0.0 (Release x64)" FontFamily="Segoe UI" FontWeight="Normal" FontSize="11" Foreground="#00E5FF"/>
                        </StackPanel>

                        <!-- Release Date -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="RELEASE DATE:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#64748B" Width="95"/>
                            <TextBlock Text="19-Nov-2026" FontFamily="Segoe UI" FontSize="11" Foreground="#CBD5E1"/>
                        </StackPanel>

                        <!-- Licence Type -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="LICENCE:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#64748B" Width="95"/>
                            <TextBlock Text="Personal Use License (Non-Commercial)" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="11" Foreground="#10B981"/>
                        </StackPanel>

                        <!-- Copyright Notice -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <TextBlock Text="COPYRIGHT:" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="#64748B" Width="95"/>
                            <TextBlock Text="© 2026 Tanym Barakah. All rights reserved." TextWrapping="Wrap" FontFamily="Segoe UI" FontSize="10.5" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
